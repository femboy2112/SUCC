  ∑ s ∈ Finset.range (n + 1), u s * (v s - v 0) =
    ObservationalSUCC.CyclotomicSelectedSource.prefixSum u (n + 1) * (v n - v 0) -
      ∑ s ∈ Finset.range n, ObservationalSUCC.CyclotomicSelectedSource.prefixSum u (s + 1) * (v (s + 1) - v s)
