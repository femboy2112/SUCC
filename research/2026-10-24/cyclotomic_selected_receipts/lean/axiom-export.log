  [inst_1 : AddCommGroup G] (u χ : G → ℂ) (C E : ℝ),
  (∀ (s d : G), χ (s + d) = χ s * χ d) →
    (∀ (s : G), ‖χ s‖ = 1) →
      ‖ObservationalSUCC.CyclotomicSelectedSource.clockCorrelation u 0‖ ≤ C →
        (∀ (d : G), d ≠ 0 → ‖ObservationalSUCC.CyclotomicSelectedSource.clockCorrelation u d‖ ≤ E) →
          ‖∑ s : G, u s * χ s‖ ^ 2 ≤ C + ↑(Fintype.card G - 1) * E
