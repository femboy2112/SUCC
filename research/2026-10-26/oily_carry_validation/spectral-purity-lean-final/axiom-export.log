ObservationalSUCC.SpectralPurity.exceptional_signed_sum_bound : ∀ (H eta : ℝ) (q : ℕ → ℝ) (bad : ℕ → Prop)
  [inst : DecidablePred bad] (N : ℕ),
  0 ≤ H →
    0 ≤ eta →
      (∀ m ∈ Finset.range N, q m ≤ H ^ 2) →
        (∀ m ∈ Finset.range N, ¬bad m → q m ≤ H * (1 + eta)) →
          ObservationalSUCC.SpectralPurity.signedInnovation H q N ≤
            eta * H * (↑N * (↑N - 1) / 2) + H ^ 2 * ObservationalSUCC.SpectralPurity.badWeight bad N
'ObservationalSUCC.SpectralPurity.exceptional_signed_sum_bound' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
