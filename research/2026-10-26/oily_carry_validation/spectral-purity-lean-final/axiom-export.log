ObservationalSUCC.SpectralPurity.sequential_normalized_identity : ∀ (H : ℝ) (q : ℕ → ℝ) (N : ℕ),
  H ≠ 0 →
    N ≠ 0 →
      ObservationalSUCC.SpectralPurity.rawEnergy H q N / (↑N ^ 2 * H) - 1 =
        (H - 1) / ↑N + 2 * ObservationalSUCC.SpectralPurity.signedInnovation H q N / (↑N ^ 2 * H)
