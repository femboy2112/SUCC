ObservationalSUCC.CarryDefect.modal_pair_budget : ∀ (counts : ℕ → ℝ) (labels : ℕ) (T M : ℝ),
  (∀ i ∈ Finset.range labels, 0 ≤ counts i) →
    (∀ i ∈ Finset.range labels, counts i ≤ M) →
