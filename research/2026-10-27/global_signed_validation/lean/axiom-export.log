ObservationalSUCC.GlobalSigned.finite_forcing_defect_transport_with_endpoints : ∀ (u w : ℕ → ℝ) (T : ℕ),
  (∀ i ≤ T, 0 ≤ u i) →
    (∀ i < T, 0 ≤ w i) →
      (∀ i < T, w i ≤ u (i + 1) + 16 * u i) →
        ∑ i ∈ Finset.range T, w i ^ 2 ≤ 289 * ∑ i ∈ Finset.range (T + 1), u i ^ 2 - 17 * u 0 ^ 2 - 272 * u T ^ 2
'ObservationalSUCC.GlobalSigned.finite_forcing_defect_transport_with_endpoints' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
