ObservationalSUCC.PolyaCoherence.weighted_row_sum : ∀ (m : ℕ) (v : ℕ → ℝ),
  ∑ i ∈ Finset.range (m + 1), ((↑m - ↑i) * v i ^ 2 + ↑i * v (i - 1) ^ 2) = (↑m + 1) * ∑ i ∈ Finset.range m, v i ^ 2
'ObservationalSUCC.PolyaCoherence.weighted_row_sum' depends on axioms: [propext, Classical.choice, Quot.sound]
