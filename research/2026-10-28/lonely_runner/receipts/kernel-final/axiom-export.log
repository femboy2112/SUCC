ObservationalSUCC.LonelyRunnerTwoEntry.upper_half_one_insertion_hole : ∀ (n r s w : ℤ),
  5 ≤ n →
    1 ≤ r →
      r < s →
        s ≤ n - 1 →
          n - 1 < 2 * r →
            n ≤ w →
              ∃ t, 0 ≤ t ∧ t ≤ 1 ∧ ∀ (i : ℤ), 1 ≤ i ∧ i < n ∧ i ≠ r ∧ i ≠ s ∨ i = w → ∀ (z : ℤ), 1 / ↑n < |↑i * ↑t - ↑z|
'ObservationalSUCC.LonelyRunnerTwoEntry.upper_half_one_insertion_hole' depends on axioms: [propext,
 Classical.choice,
