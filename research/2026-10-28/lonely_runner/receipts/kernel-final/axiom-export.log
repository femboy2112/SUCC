@SUCC.LonelyRunnerCover.closed_chain_runner_sound : ∀ {n : ℕ} (v s : Fin n → ℝ) (δ : ℝ) (left right : Fin n × ℤ → ℝ)
  (arcs : List (Fin n × ℤ)),
  SUCC.LonelyRunnerCover.ClosedChain left right 0 1 arcs →
    (∀ x ∈ arcs, 0 < v x.1 ∧ (↑x.2 - s x.1 - δ) / v x.1 ≤ left x ∧ right x ≤ (↑x.2 - s x.1 + δ) / v x.1) →
      ∀ (t : ℝ), 0 ≤ t → t ≤ 1 → ∃ i k, |s i + v i * t - ↑k| ≤ δ
'SUCC.LonelyRunnerCover.closed_chain_runner_sound' depends on axioms: [propext, Classical.choice, Quot.sound]
