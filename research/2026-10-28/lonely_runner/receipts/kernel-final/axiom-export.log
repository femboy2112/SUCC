  5 ≤ n →
    1 ≤ r ∧ r ≤ n - 2 →
      ∃ t, 0 ≤ t ∧ t ≤ 1 ∧ ∀ (i : ℤ), 1 ≤ i → i < n → i ≠ r → ∀ (z : ℤ), 2 / (2 * ↑n - 3) ≤ |↑i * t - ↑z|
