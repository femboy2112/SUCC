ObservationalSUCC.LonelyRunnerGrowth.upper_half_second_speed_bound : ∀ (n r s w₁ w₂ : ℤ),
  5 ≤ n →
    1 ≤ r →
      r < s →
        s ≤ n - 1 →
          n - 1 < 2 * r →
            n ≤ w₁ →
              w₁ < w₂ →
                ObservationalSUCC.LonelyRunnerGrowth.Covers
                    (insert w₂ (insert w₁ (ObservationalSUCC.LonelyRunnerGrowth.retainedSource n r s))) (1 / ↑n) →
                  w₂ ≤ 2 * (n - 1) * w₁
'ObservationalSUCC.LonelyRunnerGrowth.upper_half_second_speed_bound' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
