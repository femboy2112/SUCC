ObservationalSUCC.LonelyRunnerGrowth.upper_half_first_speed_geometric_bound : ∀ (n r s w₁ w₂ : ℤ),
  5 ≤ n →
    1 ≤ r →
      r < s →
        s ≤ n - 1 →
          n - 1 < 2 * r →
            n ≤ w₁ →
              w₁ < w₂ →
                ObservationalSUCC.LonelyRunnerGrowth.Covers
                    (insert w₂ (insert w₁ (ObservationalSUCC.LonelyRunnerGrowth.retainedSource n r s))) (1 / ↑n) →
                  ↑w₁ < 3 * ↑r * (↑n - 1) / (↑n - ↑r)
'ObservationalSUCC.LonelyRunnerGrowth.upper_half_first_speed_geometric_bound' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
