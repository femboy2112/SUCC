ObservationalSUCC.LonelyRunnerGrowth.two_band_right_extent : ∀ (v₁ v₂ δ a b c : ℝ) (k : ℤ),
  0 < v₁ →
    0 < v₂ →
      0 ≤ δ →
        δ < 1 / 2 →
          2 * δ / v₂ < (1 - 2 * δ) / v₁ →
            a < c →
              c < b →
                |v₁ * c - ↑k| ≤ δ →
                  (∀ (t : ℝ),
                      a < t →
                        t < b →
                          ObservationalSUCC.LonelyRunnerGrowth.Bad v₁ δ t ∨
                            ObservationalSUCC.LonelyRunnerGrowth.Bad v₂ δ t) →
                    b ≤ (↑k + δ) / v₁ + 2 * δ / v₂
'ObservationalSUCC.LonelyRunnerGrowth.two_band_right_extent' depends on axioms: [propext, Classical.choice, Quot.sound]
