ObservationalSUCC.LonelyRunnerGrowth.upper_half_safe_interval : ∀ (n r : ℤ) (t : ℝ),
  5 ≤ n →
    1 ≤ r →
      r < n →
        n - 1 < 2 * r →
          |t - 1 / ↑r| < (↑n - ↑r) / (↑n * ↑r * (↑n - 1)) →
            ∀ (i : ℤ), 1 ≤ i → i < n → i ≠ r → ∀ (z : ℤ), 1 / ↑n < |↑i * t - ↑z|
'ObservationalSUCC.LonelyRunnerGrowth.upper_half_safe_interval' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
