ObservationalSUCC.LonelyRunnerGrowth.two_band_interval_width : ∀ (v₁ v₂ δ a b : ℝ),
  0 < v₁ →
    0 < v₂ →
      0 ≤ δ →
        δ < 1 / 2 →
          2 * δ / v₂ < (1 - 2 * δ) / v₁ →
            a < b →
              (∀ (t : ℝ),
                  a < t →
                    t < b →
                      ObservationalSUCC.LonelyRunnerGrowth.Bad v₁ δ t ∨
                        ObservationalSUCC.LonelyRunnerGrowth.Bad v₂ δ t) →
                b - a ≤ 2 * δ / v₁ + 4 * δ / v₂
'ObservationalSUCC.LonelyRunnerGrowth.two_band_interval_width' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
