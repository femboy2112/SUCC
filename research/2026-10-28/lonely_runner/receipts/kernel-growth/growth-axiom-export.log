ObservationalSUCC.LonelyRunnerGrowth.two_inserted_interval_strict_width : ∀ (n w₁ w₂ : ℤ) (a b : ℝ),
  5 ≤ n →
    0 < w₁ →
      w₁ < w₂ →
        a < b →
          (∀ (t : ℝ),
              a < t →
                t < b →
                  ObservationalSUCC.LonelyRunnerGrowth.Bad (↑w₁) (1 / ↑n) t ∨
                    ObservationalSUCC.LonelyRunnerGrowth.Bad (↑w₂) (1 / ↑n) t) →
            b - a < 6 / (↑n * ↑w₁)
'ObservationalSUCC.LonelyRunnerGrowth.two_inserted_interval_strict_width' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
