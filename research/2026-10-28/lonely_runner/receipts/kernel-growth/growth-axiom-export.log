ObservationalSUCC.LonelyRunnerGrowth.finite_source_labelled_gap : ∀ (n M w : ℤ) (V : Finset ℤ) (t₀ : ℝ),
  3 ≤ n →
    1 ≤ M →
      M ≤ w →
        V.Nonempty →
          (∀ v ∈ V, 1 ≤ v) →
            (∀ v ∈ V, v ≤ M ∨ v = w) →
              0 ≤ t₀ →
                t₀ ≤ 1 →
                  (∀ v ∈ V, ∀ (z : ℤ), 1 / ↑n < |↑v * t₀ - ↑z|) →
                    ∃ a b,
                      0 ≤ a ∧
                        b ≤ 1 ∧
                          a < t₀ ∧
                            t₀ < b ∧
                              1 / (↑n * ↑w * ↑M) ≤ b - a ∧
                                (∃ u ∈ V,
                                    ∃ v ∈ V,
                                      ∃ k l,
                                        a = ObservationalSUCC.LonelyRunnerGrowth.leftEndpoint n u k ∧
                                          b = ObservationalSUCC.LonelyRunnerGrowth.rightEndpoint n v l) ∧
                                  ∀ (t : ℝ), a < t → t < b → ∀ v ∈ V, ∀ (z : ℤ), 1 / ↑n < |↑v * t - ↑z|
'ObservationalSUCC.LonelyRunnerGrowth.finite_source_labelled_gap' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
