ObservationalSUCC.LonelyRunnerGrowth.inserted_speed_bound_from_hole : ∀ (n M w₁ w₂ : ℤ) (V : Finset ℤ),
  3 ≤ n →
    1 ≤ M →
      M ≤ w₁ →
        0 < w₂ →
          V.Nonempty →
            (∀ v ∈ V, 1 ≤ v) →
              (∀ v ∈ V, v ≤ M ∨ v = w₁) →
                (∃ t₀, 0 ≤ t₀ ∧ t₀ ≤ 1 ∧ ∀ v ∈ V, ∀ (z : ℤ), 1 / ↑n < |↑v * t₀ - ↑z|) →
                  ObservationalSUCC.LonelyRunnerGrowth.Covers (insert w₂ V) (1 / ↑n) → w₂ ≤ 2 * w₁ * M
'ObservationalSUCC.LonelyRunnerGrowth.inserted_speed_bound_from_hole' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
