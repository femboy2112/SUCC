ObservationalSUCC.LonelyRunnerGrowth.endpoint_formulas : ∀ (n v k : ℤ),
  0 < n →
    0 < v →
      ObservationalSUCC.LonelyRunnerGrowth.leftEndpoint n v k = (↑k + 1 / ↑n) / ↑v ∧
